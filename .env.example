# Copy this file to .env and fill in real values. NEVER commit .env.

# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Optional: your server (guild) ID, for debugging
GUILD_ID=

# Channel ID where new members should register (<#...> ID, not the name)
REGISTRATION_CHANNEL_ID=

# Channel ID where the public welcome message is posted
WELCOME_CHANNEL_ID=

# Channel ID for #delta-international-airport (flight-style join/leave posts)
AIRPORT_CHANNEL_ID=

# Channel ID holding the city regulations (referenced in the arrival post)
RULES_CHANNEL_ID=1550810323181633576

# Channel ID where new arrivals apply for citizenship (referenced in arrival)
CITIZENSHIP_CHANNEL_ID=1550783870025338921

# Role ID pinged in the arrival post to ask an officer to clear the newcomer
IMMIGRATION_OFFICER_ROLE_ID=1550831141555273809

# Where the SQLite database file is stored (default: data/delta_city.db)
DATABASE_PATH=data/delta_city.db

# Optional: external image-generation API for citizen portraits.
# If unset, the bot uses the built-in deterministic Pillow portrait generator.
# Credentials must come from environment variables only — never hard-code them.
PORTRAIT_API_URL=
PORTRAIT_API_KEY=
